# Database Configuration
# Copy this file to .env and update with your actual database credentials

# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nlp_histo
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Azure AI Foundry ────────────────────────────────────────────────────────────
# Project-scoped endpoint (cognitiveservices.azure.com or services.ai.azure.com)
# Find it in ai.azure.com → your project → Settings
AZURE_FOUNDRY_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com
AZURE_FOUNDRY_API_KEY=your_azure_foundry_api_key_here
# API version — probed automatically if omitted; set to skip the probe
AZURE_FOUNDRY_API_VERSION=2025-04-01-preview

# ── Vertex AI ───────────────────────────────────────────────────────────────────
# Auth: run `gcloud auth application-default login` once before use
VERTEX_PROJECT=your-gcp-project-id
# Region for Gemini models (Gemini 2.5 Flash Lite, Gemini 2.5 Flash)
VERTEX_LOCATION=us-central1
# Region for Claude models on Vertex AI (Haiku 4.5, Sonnet 4.6)
# Supported: us-east5, europe-west1, europe-west4
CLAUDE_VERTEX_LOCATION=us-east5

# ── Batch mode (optional — required only for --batch flag) ───────────────────────
# Anthropic direct API key — used for Claude Haiku (L2) and Sonnet (L3) batch jobs.
# Get yours at https://console.anthropic.com/  (separate from Vertex AI billing)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# GCS bucket name for Vertex Gemini batch input/output (Gemini L1/L2 batch jobs).
# Create a bucket in the same GCP project: gsutil mb gs://your-bucket-name
# Omit to skip Vertex Gemini batch (those models fall back to sync mode).
VERTEX_BATCH_GCS_BUCKET=your-gcs-bucket-name
